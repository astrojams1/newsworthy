{
  "name": "newsworthy",
  "version": "1.0.0",
  "private": true,
  "description": "World news, rated by significance.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "rate": "node --env-file-if-exists=.env src/rate.js",
    "rate:mock": "NEWSWORTHY_MOCK=1 node src/rate.js",
    "test": "NEWSWORTHY_SQL_DRIVER=pglite node --test test/*.test.js",
    "migrate": "node --env-file-if-exists=.env -e \"import('./src/db.js').then(m=>m.ensureSchema()).then(()=>console.log('schema ready'))\"",
    "dev": "npm run start --workspace @newsworthy/client",
    "build:web": "node scripts/build-web.js",
    "check:app": "npm run typecheck --workspace @newsworthy/client",
    "mobile:check": "node scripts/check-mobile.js",
    "check:android-widget": "bash scripts/check-android-widget.sh",
    "mobile:ios": "npm run ios --workspace @newsworthy/client",
    "mobile:android": "npm run android --workspace @newsworthy/client",
    "pretest": "npm run build:web",
    "design:generate": "node scripts/generate-design.mjs",
    "design:check": "node scripts/generate-design.mjs --check",
    "test:design": "node --test test/design.test.js test/reading-gradient.test.js test/surface-design.test.js test/widget-alignment.test.js",
    "ledger": "node store/scripts/ledger.mjs",
    "design:assets": "npm run design:generate && node scripts/generate-brand.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@neondatabase/serverless": "^1.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@xmldom/xmldom": "^0.8.15",
    "playwright-core": "^1.56.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "sharp": "0.35.4"
  },
  "workspaces": [
    "apps/client"
  ],
  "overrides": {
    "react-native": "0.86.3",
    "react": "19.2.3",
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1",
    "@xmldom/xmldom": "^0.8.15",
    "uuid": "11.1.1"
  }
}
