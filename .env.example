# Required: an Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Required: Postgres. On Vercel, add a Neon database under Storage and this is
# injected for you. Locally, `vercel env pull .env` copies it down.
DATABASE_URL=postgres://...

# Required on Vercel: Vercel Cron sends this as `Authorization: Bearer <value>`
# when calling /api/cron. Any random string of 16+ characters.
CRON_SECRET=

# Optional
PORT=3000
NEWSWORTHY_MODEL=claude-opus-5
NEWSWORTHY_PROMPT_VERSION=1
NEWSWORTHY_INTERVAL_MINUTES=15

# Protects /admin and the admin APIs. Leave unset to run the admin view open
# (fine locally, not fine on the public internet).
ADMIN_TOKEN=
