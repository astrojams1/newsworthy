<?xml version="1.0" encoding="utf-8"?>
<!-- A 27dp white thumb inset 2dp in the 31dp track, as in components/toggle.tsx. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:width="31dp" android:height="31dp">
    <shape android:shape="oval"><solid android:color="#00000000"/></shape>
  </item>
  <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
    <shape android:shape="oval"><solid android:color="#FFFFFF"/></shape>
  </item>
</layer-list>
