<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_name" android:textSize="10sp" android:letterSpacing="0.18"
        android:maxLines="1" android:textColor="@color/widget_muted"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_score" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_empty_score" android:textSize="52sp" android:fontFamily="sans-serif-light"
            android:includeFontPadding="false" android:letterSpacing="-0.04" android:maxLines="1"
            android:textColor="@color/widget_ink"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_explanation" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:text="@string/widget_waiting" android:textColor="@color/widget_ink"/>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_waiting" android:textSize="10sp" android:maxLines="2"
        android:textColor="@color/widget_muted"/>
</LinearLayout>
