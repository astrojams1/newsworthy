<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_name" android:textSize="12sp" android:letterSpacing="0.18" android:textColor="@color/widget_muted"/>
    <TextView android:id="@+id/widget_score" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_empty_score" android:textSize="44sp" android:includeFontPadding="false" android:letterSpacing="-0.04" android:fontFamily="sans-serif-light" android:textColor="@color/widget_ink"/>
    <TextView android:id="@+id/widget_explanation" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:text="@string/widget_waiting" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/widget_ink"/>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_waiting" android:textSize="11sp" android:maxLines="2" android:textColor="@color/widget_muted"/>
</LinearLayout>
